{
  "name": "touch-free-response",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "setup": "node scripts/fetch-assets.mjs",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "simulate": "vitest run tests/simulation.test.ts --reporter=verbose",
    "dev:https": "HTTPS=1 vite --host",
    "postinstall": "node scripts/fetch-assets.mjs || echo 'Run npm run setup to fetch the face model.'"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}